# --- Server only (never prefix these with VITE_) -------------------------------------------
# Turns on Claude for the coach, letter reading, summaries and scripts. Put it in .env.local
# for `npm run dev`, and in your host's environment variables (e.g. Vercel) for production.
ANTHROPIC_API_KEY=
# Optional: a different model, e.g. claude-sonnet-5-5 or claude-haiku-5-5 to lower cost.
CLAUDE_MODEL=
# Optional: only these origins may call /api (comma-separated), e.g. https://comppilot.app
ALLOWED_ORIGINS=

# --- Browser --------------------------------------------------------------------------------
# Where the AI server lives. Defaults to /api on the same site. Set to "off" to never use it.
VITE_AI_SERVER=
